--- 

import Layout from "../layouts/Layout.astro";
import BackgroundParticles from "../components/astro/BackgroundParticles.astro";
import AboutMe from "../components/astro/AboutMe.astro";
import StoreSection from "../components/astro/StoreSection.astro";
import MarketSection from "../components/astro/MarketSection.astro";
import { CustomCursor } from "../components/react/CustomCursor.jsx";
import FilmStrip from "../components/react/FilmStrip.jsx";
import Donation from "../components/astro/Donation.astro";
import SkillsShowcase from "../components/astro/Experience.astro";
import Header from "../components/astro/Header.astro";
---

<Layout>
  <CustomCursor client:only="react" />

  <main id="page-shell" class="page-shell">
    <section
      id="hero"
      class="slide relative flex items-center justify-center overflow-hidden text-white"
      data-section
    >
      <BackgroundParticles />
      <div class="absolute inset-0 bg-black/40 backdrop-blur-[1px]"></div>

<div
        id="hero-content"
        class="relative z-10 flex w-full max-w-[1520px] flex-col items-center px-6 text-center manga-slam"
      >
        <!-- Boot text -->
        <p class="boot-text mb-4 font-rajdhani text-lg md:text-xl tracking-wider text-offwhite/80 opacity-0 animate-[fadeInUp_2s_0.5s_ease-out_forwards]">System.Initialize...</p>
        
        <!-- Brush stroke behind title -->
        <div class="hero-brush absolute -inset-20 opacity-30 md:opacity-40 ink-splatter" style="transform: rotate(-15deg);"></div>
        
        <div class="hero-title-shell relative z-10">
        <h1
          class="manga-heading text-[5rem] md:text-[9rem] lg:text-[11rem]
                 uppercase tracking-[0.2em] md:tracking-[0.25em]
                 relative flex items-baseline bg-gradient-to-r from-white to-offwhite bg-clip-text text-transparent drop-shadow-2xl ink-glow-strong"
        >
          <span class="letter">F</span><span class="letter inline-block mx-[-0.2em]">r</span><span class="letter">a</span><span class="letter inline-block mx-[-0.1em]">x</span><span class="letter">b</span>
        </h1>
        </div>

        <!-- Profile Image with Aura -->
        <div class="hero-profile mt-12 relative">
          <img 
            src="/public/Profile.JPG" 
            alt="Fraxb Profile" 
            class="w-48 h-48 md:w-64 md:h-64 rounded-3xl border-8 border-black/50 shadow-2xl mx-auto pulsing-aura ink-glow-strong object-cover"
            loading="lazy"
          />
          <div class="aura-ring absolute inset-0 rounded-3xl bg-gradient-to-r from-white/30 to-white/10 animate-[spin_20s_linear_infinite] opacity-60 blur-xl"></div>
        </div>

        <!-- Typewriter Subtitles -->
        <div class="hero-subtitles mt-12 text-center max-w-2xl mx-auto">
          <p class="subtitle-line font-inter text-xl md:text-2xl lg:text-3xl text-white/90 tracking-wide leading-relaxed typewriter-text" data-texts='["Film Photographer", "Visual Artist", "Explorer", "Gamer", "Designer", "Coder", "Storyteller"]'></p>
        </div>
      </div>
    </section>

    <section id="about" class="slide slide--bleed" data-section>
      <AboutMe />
    </section>

    <section id="store" class="slide slide--bleed" data-section>
      <StoreSection />
    </section>

    <section id="market" class="slide slide--bleed" data-section>
      <MarketSection client:load />
    </section>

    <section id="skills" class="slide slide--bleed overflow-hidden" data-section>
      <SkillsShowcase />
    </section>

    <section id="film" class="slide slide--bleed overflow-hidden relative" data-section>
      <FilmStrip client:load />
    </section>

    <section id="donation" class="slide slide--bleed" data-section>
      <Donation />
    </section>
  </main>

<Header />
</Layout>

<style>
.page-shell {
  position: relative;
  height: 100svh;
  overflow-y: auto;
  overflow-x: hidden;
  overscroll-behavior: none;
  scroll-snap-type: y mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
}

.page-shell::-webkit-scrollbar {
  display: none;
}

.slide {
  position: relative;
  width: 100%;
  min-height: 100svh;
  height: 100svh;
  scroll-snap-align: start;
  scroll-snap-stop: always;
  padding: 0;
}

.slide--bleed {
  padding: 0;
}

#skills {
  overflow: hidden;
}

#film {
  overflow: hidden;
  isolation: isolate;
}

/* Force astro-island to fill the film section */
#film astro-island {
  display: block;
  width: 100%;
  height: 100%;
}

/* Hero letters animation */
.letter {
  display: inline-block;
  opacity: 0;
  transform: translateY(30px) scale(0.8);
  animation: letterIn 0.8s ease forwards, letterBounce 2.5s ease-in-out 1.4s infinite;
}
.letter:nth-child(1) { animation-delay: 0s; }
.letter:nth-child(2) { animation-delay: 0.2s; }
.letter:nth-child(3) { animation-delay: 0.4s; }
.letter:nth-child(4) { animation-delay: 0.6s; }
.letter:nth-child(5) { animation-delay: 0.8s; }



.hero-title-shell {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 1rem 1.5rem;
}

/* Hero Manga Styles */
.hero-brush {
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.boot-text {
  font-family: 'Rajdhani', monospace;
  letter-spacing: 0.3em;
  text-transform: uppercase;
}

.aura-ring {
  animation: pulsingAura 2s ease-in-out infinite;
}

.typewriter-text::after {
  content: '|';
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}


@keyframes letterIn {
  from { opacity: 0; transform: translateY(30px) scale(0.8); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes letterBounce {
  0%, 100% { transform: translateY(0) scale(1); }
  25% { transform: translateY(-8px) scale(1.02); }
  50% { transform: translateY(0) scale(1); }
  75% { transform: translateY(-4px) scale(1.01); }
}


.billboard {
  display: inline-block;
  font-weight: 700;
  animation: jumpingLetters 2s ease-in-out infinite;
}

.hero-subtitle {
  max-width: min(92vw, 960px);
  color: rgba(255,255,255,0.86);
  text-shadow: 0 0 16px rgba(255,255,255,0.08);
  text-wrap: balance;
}


/* Tagline reveal */
.animate-reveal {
  animation: fadeUp 2s ease forwards;
  animation-delay: 1.5s;
}
@keyframes fadeUp {
  from { transform: translateY(30px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}


.scroll-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 1rem;
  border-bottom: 2px solid rgba(255,255,255,0.15);
  border-radius: 0;
  background: rgba(5, 10, 20, 0.95);
  backdrop-filter: blur(24px);
  box-shadow: 0 8px 45px rgba(0,0,0,0.4);
}

.scroll-nav--horizontal .scroll-nav__item {
  min-width: auto;
  white-space: nowrap;
}

@media (max-width: 768px) {
  .scroll-nav {
    gap: 0.4rem;
    padding: 0.75rem;
  }
  .scroll-nav__item {
    padding: 0.4rem 0.7rem;
    font-size: 0.65rem;
  }
}


.scroll-nav__item {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  border: none;
  border-radius: 9999px;
  background: transparent;
  width: 100%;
  padding: 0.55rem 0.8rem;
  color: rgba(255,255,255,0.55);
  transition: background-color 220ms ease, color 220ms ease, transform 220ms ease;
}

.scroll-nav__item:hover {
  transform: translateY(-1px);
  color: rgba(255,255,255,0.86);
}

.scroll-nav__item.active {
  background: rgba(34, 211, 238, 0.14);
  color: rgba(255,255,255,0.96);
}

.scroll-nav__dot {
  width: 0.48rem;
  height: 0.48rem;
  border-radius: 9999px;
  background: rgba(255,255,255,0.35);
  box-shadow: 0 0 0 1px rgba(255,255,255,0.12);
  transition: background-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
}

.scroll-nav__item.active .scroll-nav__dot {
  background: rgb(34, 211, 238);
  box-shadow: 0 0 14px rgba(34, 211, 238, 0.75);
  transform: scale(1.08);
}

.scroll-nav__label {
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  white-space: nowrap;
}

@media (max-width: 768px) {
  .hero-title-shell {
    padding: 0.65rem 0.5rem;
  }

  .scroll-nav {
    right: 0.55rem;
    min-width: 7.75rem;
    padding: 0.4rem;
    gap: 0.22rem;
  }

  .scroll-nav__item {
    justify-content: flex-start;
    padding: 0.48rem 0.6rem;
  }

  .scroll-nav__label {
    display: inline;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
  }
}
</style>

<script is:inline>
  // Hero Typewriter Effect
  const typewriterEl = document.querySelector('.typewriter-text');
  if (typewriterEl) {
    const texts = JSON.parse(typewriterEl.dataset.texts || '[]');
    let textIndex = 0;
    let charIndex = 0;
    
    const typeText = () => {
      if (charIndex < texts[textIndex].length) {
        typewriterEl.textContent = texts[textIndex].slice(0, charIndex + 1);
        charIndex++;
        setTimeout(typeText, 100);
      } else {
        setTimeout(() => {
          charIndex = 0;
          textIndex = (textIndex + 1) % texts.length;
          typewriterEl.textContent = '';
          typeText();
        }, 2000);
      }
    };
    setTimeout(typeText, 2000);
  }
  
  // Existing page shell scroll logic (unchanged)
  const pageShell = document.getElementById("page-shell");
  // ... (keep all existing script unchanged)
</script>
