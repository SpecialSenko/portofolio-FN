  { text: "GamerPay", link: "https://gamerpay.gg/partner/525d38b58d" },
  { text: "Wise", link: "https://wise.com/invite/dic/thoriqa4" },
  { text: "REF2E5288", copy: true, link: "https://csgo-skins.com/account" },
  { text: "SKIN CASH", link: "https://skins.cash/user/ref/76561199088840145" },
  { text: "nfeu3o2", copy: true, link: "https://csgofast.com/account/referral/campaigns" },
  { text: "HoneyGain", copy: true, link: "https://join.honeygain.com/ALFAT1D1B1" },
  { text: "Microsoft", link: "https://rewards.bing.com/welcome?rh=1830CE79&ref=rafsrchae&form=ML2XE3&OCID=ML2XE3&PUBL=RewardsDO&CREA=ML2XE3" },
  { type: "video", src: "/videos/casehug.webm",    link: "https://casehug.com/b/1BBC466A48924B3D" },
  { type: "video", src: "/videos/KISSORKILL.webm", link: "https://kd.media/banner?code=RBCCHMTI" },
];

const sponsorAds = [
  { text: "RENT", link: "#" },
  { text: "RENT", link: "#" },
  { text: "RENT", link: "#" },
  { text: "RENT", link: "#" },
];
---

<style>
/* ── layout ───────────────────────────────────────────────── */
.ads-container {
  display: flex;
  scroll-snap-type: x mandatory;
  overflow-x: auto;
  gap: clamp(24px, 5vw, 48px);
}

.ads-container::-webkit-scrollbar { height: 4px; }
.ads-container::-webkit-scrollbar-track { background: rgba(17,17,17,0.8); }
.ads-container::-webkit-scrollbar-thumb { background: #fff; border-radius: 2px; }
  flex-direction: row;
  align-items: flex-start;
  justify-content: center;
  gap: clamp(16px, 4vw, 40px);
  width: 100%;
  max-width: min(900px, 96vw);
  margin: 0 auto;
  padding: clamp(24px, 6vw, 60px) clamp(12px, 4vw, 20px);
  box-sizing: border-box;
}

/* stack columns on small screens */
@media (max-width: 600px) {
  .ads-container {
    flex-direction: column;
    align-items: stretch;
    gap: 20px;
  }
}

/* ── card ─────────────────────────────────────────────────── */
.text-box {
  flex: 1;
  min-width: 0;
  background: black;
  backdrop-filter: blur(14px);
  border-radius: 12px;
  border: 3px solid white;
  padding: clamp(20px, 4vw, 32px);
  box-shadow: 0 12px 48px rgba(0,0,0,0.9), inset 0 0 0 1px rgba(255,255,255,0.1), manga-panel;
  position: relative;
  font-family: 'Rajdhani', monospace;
}

.text-box h3 {
  text-align: center;
  color: white;
  font-size: clamp(14px, 2vw, 18px);
  text-transform: uppercase;
  letter-spacing: 0.3em;
  margin: 0 0 clamp(16px, 3vw, 24px) 0;
  font-weight: 800;
  text-shadow: 2px 2px 0 black;
  position: relative;
}

.text-box h3::after {
  content: '';
  position: absolute;
  bottom: -8px;
  left: 50%;
  transform: translateX(-50%);
  width: 60px;
  height: 4px;
  background: url('/textures/brush-stroke-diagonal.svg') no-repeat center/contain;
}

.text-box h3 {
  text-align: center;
  color: white;
  font-size: clamp(10px, 1.5vw, 12px);
  text-transform: uppercase;
  letter-spacing: 3px;
  margin: 0 0 clamp(10px, 2vw, 14px) 0;
  opacity: 0.9;
}

/* ── list ─────────────────────────────────────────────────── */
.text-list {
  display: flex;
  flex-direction: column;
  gap: clamp(6px, 1.2vw, 8px);
}

/* ── item ─────────────────────────────────────────────────── */
.text-item {
  display: block;
  background: black;
  border: 2px solid white;
  border-radius: 4px;
  padding: clamp(12px, 2vw, 16px) clamp(16px, 3vw, 20px);
  color: white;
  font-size: clamp(12px, 1.8vw, 14px);
  text-decoration: none;
  transition: all 0.4s cubic-bezier(0.34,1.56,0.64,1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
  position: relative;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  text-shadow: 1px 1px 0 #000;
}

.text-item::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(145deg, #111, transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.text-item:hover {
  transform: translateY(-6px) scale(1.02);
  border-color: #f0f0f0;
  box-shadow: 
    ink-glow-strong,
    0 20px 60px rgba(0,0,0,0.9);
  text-shadow: 2px 2px 0 #000, 0 0 12px #fff;
}

.text-item:hover::before {
  opacity: 1;
}

.text-item:hover {
  transform: translateX(4px);
  background: rgba(255,255,255,0.07);
  box-shadow: 0 0 12px rgba(255,255,255,0.12);
}

/* on phones, don't slide — just highlight */
@media (max-width: 600px) {
  .text-item:hover {
    transform: none;
  }
  .text-item:active {
    background: rgba(255,255,255,0.16);
  }
}

/* ── banner (video) ───────────────────────────────────────── */
.text-item.banner {
  padding: 0;
  height: clamp(44px, 8vw, 52px);
  overflow: hidden;
  position: relative;
  border: 1px solid rgba(255,255,255,0.18);
  box-shadow:
    0 0 12px rgba(255,255,255,0.12),
    inset 0 0 14px rgba(255,255,255,0.08);
}

.text-item.banner:hover {
  box-shadow:
    0 0 18px rgba(255,255,255,0.18),
    inset 0 0 18px rgba(255,255,255,0.1);
}

.text-item.banner video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ── divider ──────────────────────────────────────────────── */
.divider {
  width: 4px;
  align-self: stretch;
  background: linear-gradient(to bottom, transparent, #fff, transparent);
  box-shadow: 0 0 24px #fff;
  position: relative;
  flex-shrink: 0;
  border-radius: 2px;
}

.divider::before {
  content: ' ';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 20px #fff;
}

.divider::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: white;
  box-shadow: 0 0 14px white;
}

/* on phones the divider becomes a horizontal rule */
@media (max-width: 600px) {
  .divider {
    width: 100%;
    height: 2px;
    align-self: auto;
    background: linear-gradient(to right, transparent, rgba(255,255,255,0.9), transparent);
    box-shadow: 0 0 16px rgba(255,255,255,0.8);
  }

  .divider::before {
    top: 50%;
    left: 50%;
  }
}
</style>

<div class="ads-container">

  <!-- Referrals -->
  <div class="text-box">
    <h3>My Referrals</h3>
    <div class="text-list">
      {myReferrals.map(ref =>
        ref.type === "video" ? (
          <a class="text-item banner" href={ref.link} target="_blank" rel="noopener noreferrer">
            <video autoplay loop muted playsinline preload="auto">
              <source src={ref.src} type="video/webm" />
            </video>
          </a>
        ) : (
          <a class="text-item" href={ref.link} target="_blank" rel="noopener noreferrer">
            {ref.text}
          </a>
        )
      )}
    </div>
  </div>

  <div class="divider"></div>

  <!-- Sponsor Ads -->
  <div class="text-box">
    <h3>Sponsor Ads</h3>
    <div class="text-list">
{sponsorAds.map((ad, index) => (
        <a class="text-item rent-slot border-dashed border-white/60 animate-[blink_1.5s_infinite]" href={ad.link} target="_blank" rel="noopener noreferrer" style="--blink-delay: ${index * 0.3}s">
          SLOT<br/>AVAILABLE
        </a>
      ))}
    </div>
  </div>

</div>

<script is:inline>
  document.querySelectorAll("video").forEach(v => {
    v.muted = true;
    v.play().catch(() => {});
  });
</script>
