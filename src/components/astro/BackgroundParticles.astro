<canvas id="canvas" class="w-screen h-screen fixed z-[-10]"></canvas>

<script>
const el = document.getElementById("canvas");
if (!(el instanceof HTMLCanvasElement)) {
  throw new Error("Canvas element '#canvas' not found");
}
const canvas = el;
const ctx = canvas.getContext("2d")!;
if (!ctx) {
  throw new Error("2D rendering context not available");
}

// CONFIG
const MAX_COMETS = 5;
let nextCometTime = performance.now() + Math.random() * 4000 + 2000;

let mouse = { x: 0, y: 0 };

function resize() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
resize();
window.addEventListener("resize", resize);

// ===== BLACK & WHITE ONLY
const starColors = ["#ffffff", "#dddddd", "#bbbbbb", "#999999"];

// ===== STAR
class Star {
  x: number = 0;
  y: number = 0;
  size: number = 0;
  twinkle: number = 0;
  color: string = "";

  constructor() { this.reset(); }
  reset() {
    this.x = Math.random() * canvas.width;
    this.y = Math.random() * canvas.height;
    this.size = Math.random() * 1.5 + 0.3;
    this.twinkle = Math.random() * Math.PI * 2;
    this.color = starColors[Math.floor(Math.random() * starColors.length)];
  }
  update() { this.twinkle += 0.02; }
  draw() {
    const px = this.x + (mouse.x - canvas.width / 2) * 0.003;
    const py = this.y + (mouse.y - canvas.height / 2) * 0.003;
    const alpha = 0.4 + Math.sin(this.twinkle) * 0.3;

    ctx.globalAlpha = alpha;
    ctx.fillStyle = this.color;
    ctx.beginPath();
    ctx.arc(px, py, this.size, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalAlpha = 1;
  }
}

// ===== NEBULA
class Nebula {
  x: number;
  y: number;
  size: number;
  alpha: number;
  speed: number;

  constructor() {
    this.x = Math.random() * canvas.width;
    this.y = Math.random() * canvas.height;
    this.size = Math.random() * 300 + 200;
    this.alpha = Math.random() * 0.025 + 0.015;
    this.speed = Math.random() * 0.05 + 0.03;
  }
  update() { this.x += this.speed; if (this.x > canvas.width + this.size) this.x = -this.size; }
  draw() {
    const g = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.size);
    g.addColorStop(0, `rgba(255,255,255,${this.alpha})`);
    g.addColorStop(1, "rgba(255,255,255,0)");
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
    ctx.fill();
  }
}

// ===== COMET
class Comet {
  x: number;
  y: number;
  vx: number;
  vy: number;
  life: number;
  fade: number;
  trail: Array<{ x: number; y: number; a: number }>;
  maxTrail: number;

  constructor() {
    this.x = -80;
    this.y = Math.random() * canvas.height * 0.8 + canvas.height * 0.1;
    this.vx = Math.random() * 2 + 2.5;
    this.vy = Math.random() * 0.25 - 0.12;
    this.life = 1;
    this.fade = 0.015;
    this.trail = [];
    this.maxTrail = 18;
  }
  update() {
    this.x += this.vx;
    this.y += this.vy;
    this.life -= this.fade;
    this.trail.push({ x: this.x, y: this.y, a: this.life });
    if (this.trail.length > this.maxTrail) this.trail.shift();
    return this.life > 0;
  }
  draw() {
    for (let i = 0; i < this.trail.length; i++) {
      const t = this.trail[i];
      const alpha = (i / this.trail.length) * t.a;
      ctx.globalAlpha = alpha * 0.18;
      const g = ctx.createRadialGradient(t.x, t.y, 0, t.x, t.y, 8);
      g.addColorStop(0, "rgba(255,255,255,0.6)");
      g.addColorStop(1, "rgba(255,255,255,0)");
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(t.x, t.y, 8, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.globalAlpha = this.life;
    const head = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, 10);
    head.addColorStop(0, "rgba(255,255,255,0.75)");
    head.addColorStop(1, "rgba(255,255,255,0)");
    ctx.fillStyle = head;
    ctx.beginPath();
    ctx.arc(this.x, this.y, 10, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalAlpha = 1;
  }
}

// ===== INIT
const stars: Star[] = [];
const nebulas: Nebula[] = [];
const comets: Comet[] = [];

for (let i = 0; i < 220; i++) stars.push(new Star());
for (let i = 0; i < 6; i++) nebulas.push(new Nebula());

// ===== ANIMATE
function animate() {
  const bg = ctx.createLinearGradient(0, 0, 0, canvas.height);
  bg.addColorStop(0, "#000000");
  bg.addColorStop(1, "#0d0d0d");
  ctx.fillStyle = bg;
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  nebulas.forEach(n => { n.update(); n.draw(); });
  stars.forEach(s => { s.update(); s.draw(); });

  // RANDOM comet spawn (1–5)
  const now = performance.now();
  if (comets.length < MAX_COMETS && now > nextCometTime) {
    comets.push(new Comet());
    nextCometTime = now + Math.random() * 6000 + 2000; // 2–8s until next
  }

  for (let i = comets.length - 1; i >= 0; i--) {
    if (!comets[i].update()) comets.splice(i, 1);
    else comets[i].draw();
  }

  requestAnimationFrame(animate);
}

document.addEventListener("mousemove", e => {
  mouse.x = e.clientX;
  mouse.y = e.clientY;
});

animate();
</script>
