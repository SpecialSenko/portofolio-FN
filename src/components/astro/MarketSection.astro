---
---

<section class="market-section h-full w-full p-8 md:p-12 bg-gradient-to-br from-slate-900/50 to-black/70 backdrop-blur-sm">
  <div class="text-center mb-12">
    <h2 class="text-5xl md:text-7xl bebas-neue font-black uppercase tracking-widest ink-glow-strong manga-panel-line mb-4">MARKET</h2>
    <p class="max-w-2xl mx-auto text-xl text-offwhite/90 halftone-overlay">Live CSFloat/Steam listings. Drag to browse your marketplace stall.</p>
  </div>
  <div class="market-grid overflow-x-auto scrollbar-thin h-[65vh] md:h-[75vh] snap-x snap-mandatory">
    <!-- Demo cards – replace with API -->
    <div class="market-card snap-center shrink-0 w-48 h-64 mx-2 bg-black/90 backdrop-blur-md manga-panel-line rounded-xl p-4 ink-glow hover:shadow-white/50 transition-all duration-300 hover:-translate-y-2 hover:scale-105">
      <div class="h-32 w-full rounded-lg overflow-hidden mb-3 bg-gray-900/50">
        <img src="/assets/games/FN MC.png" alt="AK Redline" class="w-full h-full object-cover" />
      </div>
      <div class="text-offwhite">
        <h4 class="font-bold text-sm mb-1 truncate bebas-neue">AK-47 | Redline FT</h4>
        <div class="flex justify-between items-center text-xs mb-2">
          <span class="text-white font-bold">$12.45</span>
          <span class="px-2 py-1 bg-white/20 text-white rounded-full text-xs font-bold blinking">Live</span>
        </div>
      </div>
    </div>
    <!-- More cards... -->
    <div class="market-card snap-center shrink-0 w-48 h-64 mx-2 bg-gradient-to-br from-purple-900/80 to-blue-900/80 backdrop-blur-md border border-blue-500/30 rounded-xl p-4 shadow-2xl hover:shadow-blue-500/50 transition-all duration-300 hover:-translate-y-2 hover:scale-105">
      <div class="h-32 w-full rounded-lg overflow-hidden mb-3 bg-black/30">
        <img src="/assets/games/image.webp" alt="Glove" class="w-full h-full object-cover brightness-125" />
      </div>
      <div class="text-white">
        <h4 class="font-bold text-sm mb-1 truncate">Glove | Study MW</h4>
        <div class="flex justify-between items-center text-xs mb-2">
          <span class="text-green-400 font-bold">$89.99</span>
          <span class="px-2 py-1 bg-blue-500/20 text-blue-400 rounded-full text-xs font-bold">Stall</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.market-section { scroll-snap-type: x mandatory; }
.market-grid::-webkit-scrollbar { height: 6px; }
.market-grid::-webkit-scrollbar-track { background: rgba(15,23,42,0.5); border-radius: 3px; }
.market-grid::-webkit-scrollbar-thumb { background: rgba(100,116,139,0.7); border-radius: 3px; }
.market-card { scroll-snap-align: center; }
</style>
