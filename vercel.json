{
  "buildCommand": "npm run build || echo 'No build needed'",
  "outputDirectory": "dist",
  "devCommand": "node scripts/local-auth-server.mjs --host 0.0.0.0 --port 3000",
  "framework": null,
  "env": {
    "NODE_ENV": "production",
    "SESSION_SECRET": "@SESSION_SECRET",
    "STEAM_API_KEY": "@STEAM_API_KEY",
    "STEAM_RETURN_URL": "@STEAM_RETURN_URL",
    "PORT": "3000"
  },
  "rewrites": [
    {
      "source": "/api/auth/me",
      "destination": "/api/auth/me.js"
    },
    {
      "source": "/api/auth/steam/login",
      "destination": "/api/auth/steam/login.js"
    },
    {
      "source": "/api/auth/steam/callback",
      "destination": "/api/auth/steam/callback.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
