{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "node scripts/local-auth-server.mjs --host 0.0.0.0 --port 3000",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/physical/:action",
      "destination": "/api/physical"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
